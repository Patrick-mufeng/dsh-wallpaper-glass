{
  "name": "dsh-wallpaper-glass",
  "version": "1.4.2-slim.1",
  "description": "Wallpaper-engine backgrounds with iOS-style liquid glass for the DSH web GUI. Slim fork of dsh-plugin-wallpaper-engine@1.4.2 (upstream: elysia395/dsh-wallpaper-engine, MIT): wallpaper + liquid glass + fonts only.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "dsh": "^0.2.0-rc.1"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "icon": "./icon.png",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "wallpaper",
    "wallpaper-engine",
    "theme",
    "background",
    "glass",
    "liquid-glass"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./subpackage-boot.js": "./lib/subpackage-boot.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.png",
    "lib/index.js",
    "lib/host-boot.js",
    "lib/log.js",
    "lib/notice.js",
    "lib/cache-keys.js",
    "lib/kernel/",
    "lib/kernel/data-dir.js",
    "lib/kernel/config.js",
    "lib/kernel/host-kernel.js",
    "lib/kernel/host-session.js",
    "lib/routes/",
    "lib/occlusion/",
    "lib/fontsets/",
    "lib/glass-presets/",
    "lib/component-visibility.js",
    "lib/client.js",
    "lib/http-body.js",
    "lib/json-response.js",
    "lib/pkg-read.js",
    "lib/scene-manifest.js",
    "lib/settings-schema.js",
    "lib/subpackage-boot.js",
    "lib/media/",
    "lib/media/transcode.js",
    "lib/media/mp4-probe.js",
    "lib/media/scene-probe.js",
    "lib/media/video-preview.js",
    "lib/media/frame-store.js",
    "lib/media/media-dirs.js",
    "lib/media-origin.js",
    "lib/inventory.js",
    "lib/serve.js",
    "lib/faststart.js",
    "lib/cache-dir.js",
    "lib/upload-store.js",
    "lib/diag-trace.js",
    "lib/http-lifecycle.js",
    "lib/mp4-vfs.js",
    "lib/startup-sweep.js",
    "lib/fs-paths.js",
    "lib/upload-dir.js",
    "lib/wallpaper-scan.js",
    "lib/steam-discovery.js",
    "lib/webwallgl/",
    "lib/we-assets.js",
    "lib/shim-seed.js",
    "lib/we-props.js",
    "lib/we-focus-guard.js",
    "lib/types/index.d.ts",
    "lib/types/client.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "README.beginner.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.5-rc.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "dependencies": {
    "webwallgl": "^3.0.0",
    "x11": "^4.3.1",
    "dsh-wallpaper-glass-fonts": "1.4.2",
    "dsh-wallpaper-glass-ui": "1.4.2",
    "dsh-wallpaper-glass-media-bridge": "1.4.2"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
